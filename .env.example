NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Weather providers
OPENWEATHER_API_KEY=your_openweathermap_key_here
# Open-Meteo requires no key — used as the primary provider

# AI summary (optional, service is provider-agnostic — plug in either)
OPENAI_API_KEY=
GEMINI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WeatherSphere Pro

# Protects /api/cron/check-alerts from unauthenticated triggers
CRON_SECRET=replace-with-a-random-string
